rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function configPath() { return /databases/$(database)/documents/chronicle/config; }
    function myRole() {
      return exists(userPath(request.auth.uid)) ? get(userPath(request.auth.uid)).data.role : 'none';
    }
    function isPrincipal() { return signedIn() && myRole() == 'principal'; }
    // Conteur ou principal. Le narrateur n'a pas accès aux comptes (C33).
    function managesAccounts() { return signedIn() && myRole() in ['conteur', 'principal']; }
    function tokenEmail() { return request.auth.token.email.lower(); }
    function invitationPath() { return /databases/$(database)/documents/invitations/$(tokenEmail()); }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 60; }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isStaff() { return signedIn() && myRole() in ['narrateur', 'conteur', 'principal']; }
    function charPath(id) { return /databases/$(database)/documents/characters/$(id); }
    function histPath(id, h) { return /databases/$(database)/documents/characters/$(id)/history/$(h); }
    // L'entrée d'historique désignée par la nouvelle version, créée dans le même lot par l'auteur.
    function historyOk(id, kinds) {
      let h = getAfter(histPath(id, request.resource.data.lastHistoryId)).data;
      return h.byUid == request.auth.uid && h.at == request.time && h.kind in kinds;
    }

    // Premier lancement : users/{uid} en principal + chronicle/config dans le même batch.
    function isFirstPrincipal() {
      return request.resource.data.role == 'principal'
        && !exists(configPath())
        && getAfter(configPath()).data.ownerUid == request.auth.uid;
    }

    function selfUpdate(uid) {
      return request.auth.uid == uid && (
        (changedOnly(['displayName', 'email', 'lastLoginAt'])
          && validName(request.resource.data.displayName)
          && request.resource.data.email == request.auth.token.email)
        || acceptsInvitation()
      );
    }

    function acceptsInvitation() {
      return resource.data.role == 'pending'
        && changedOnly(['role'])
        && request.auth.token.email_verified == true
        && exists(invitationPath())
        && request.resource.data.role == get(invitationPath()).data.role;
    }

    function accountManagerUpdate(uid) {
      return changedOnly(['role']) && request.auth.uid != uid && (
        (isPrincipal()
          && request.resource.data.role in ['joueur', 'narrateur', 'conteur', 'principal', 'disabled'])
        || (myRole() == 'conteur'
          && (resource.data.role + '>' + request.resource.data.role)
            in ['pending>joueur', 'pending>disabled', 'joueur>disabled', 'disabled>joueur'])
      );
    }

    match /chronicle/config {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.role == 'principal';
      allow update: if isPrincipal()
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }

    // Paramètres d'expérience (sous-projet 4) : gain mensuel et paliers.
    match /chronicle/xp {
      allow read: if signedIn();
      allow write: if managesAccounts();
    }

    // Historiques de toutes les fiches (liste des corrections) : l'équipe seulement.
    match /{path=**}/history/{h} {
      allow read: if isStaff();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || managesAccounts());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'accessMessage', 'createdAt', 'lastLoginAt'])
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.displayName)
        && (request.resource.data.role == 'pending' || isFirstPrincipal());
      allow update: if signedIn() && (selfUpdate(uid) || accountManagerUpdate(uid));
    }

    match /characters/{id} {
      allow read: if signedIn()
        && (resource.data.get('playerUid', null) == request.auth.uid || isStaff());

      allow create: if managesAccounts()
        && request.resource.data.version == 1
        && historyOk(id, ['creation'])
        && ((request.resource.data.kind == 'pj' && request.resource.data.status == 'draft'
              && request.resource.data.playerUid is string
              && request.resource.data.playerUid != request.auth.uid)
          || (request.resource.data.kind == 'pnj' && request.resource.data.status == 'active'
              && request.resource.data.get('playerUid', null) == null));

      allow update: if signedIn()
        && request.resource.data.version == resource.data.version + 1
        && (staffEdit(id) || playerDraftSave() || playerSubmission(id) || staffBonus(id) || staffDecision(id));

      function staffEdit(id) {
        return managesAccounts()
          && resource.data.get('playerUid', null) != request.auth.uid
          && request.resource.data.get('playerUid', null) != request.auth.uid
          && (resource.data.kind == 'pnj' || resource.data.status in ['active', 'retired', 'dead'])
          && (request.resource.data.kind == 'pnj' || request.resource.data.status in ['active', 'retired', 'dead'])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kind', 'createdAt'])
          && historyOk(id, ['edit', 'status', 'xp', 'award', 'gain', 'correction', 'embrace'])
          && getAfter(histPath(id, request.resource.data.lastHistoryId)).data.reason.size() > 0;
      }

      function own() { return resource.data.get('playerUid', null) == request.auth.uid; }
      // À la milliseconde : une date écrite depuis Android (microsecondes) revient du Web tronquée.
      function sameTime(a, b) {
        return a == b || (a != null && b != null && a.toMillis() == b.toMillis());
      }
      function decisionUnchanged() {
        return sameTime(request.resource.data.creation.get('decidedAt', null), resource.data.creation.get('decidedAt', null))
          && request.resource.data.creation.get('decidedByUid', null) == resource.data.creation.get('decidedByUid', null)
          && request.resource.data.creation.get('comment', null) == resource.data.creation.get('comment', null);
      }

      // Le joueur remplit son brouillon : sans historique, sans champ protégé.
      function playerDraftSave() {
        return own() && resource.data.status == 'draft' && request.resource.data.status == 'draft'
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['playerUid', 'playerName', 'kind', 'xpBonus', 'status', 'createdAt', 'lastHistoryId', 'gainedThrough', 'ghoul', 'embrace'])
          && decisionUnchanged();
      }

      function playerSubmission(id) {
        let from = resource.data.status;
        let to = request.resource.data.status;
        return own()
          && ((from == 'draft' && to == 'review') || (from == 'review' && to == 'draft'))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'creation', 'xpInitial', 'xpEarned', 'xpSpent', 'version', 'lastHistoryId', 'updatedAt'])
          && decisionUnchanged()
          && historyOk(id, [to == 'review' ? 'submission' : 'withdrawal']);
      }

      function staffBonus(id) {
        return managesAccounts() && !own()
          && resource.data.status == 'draft' && request.resource.data.status == 'draft'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xpBonus', 'version', 'lastHistoryId', 'updatedAt'])
          && historyOk(id, ['bonus']);
      }

      function staffDecision(id) {
        let to = request.resource.data.status;
        let kind = to == 'active' ? 'validation' : (to == 'draft' ? 'corrections' : 'rejection');
        return managesAccounts() && !own()
          && resource.data.status == 'review' && to in ['active', 'draft', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'creation', 'version', 'lastHistoryId', 'updatedAt'])
          && historyOk(id, [kind])
          && (to == 'active' || getAfter(histPath(id, request.resource.data.lastHistoryId)).data.reason.size() > 0);
      }

      match /history/{h} {
        allow read: if signedIn()
          && (get(charPath(id)).data.get('playerUid', null) == request.auth.uid || isStaff());
        allow create: if signedIn()
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.at == request.time
          && getAfter(charPath(id)).data.lastHistoryId == h;
      }

      match /private/{doc} {
        allow read, write: if managesAccounts()
          && get(charPath(id)).data.get('playerUid', null) != request.auth.uid;
      }
    }

    // Demandes d'XP (sous-projet 4). Le joueur écrit tant que la demande est ouverte ; le conte tranche.
    match /requests/{rid} {
      allow read: if signedIn() && (resource.data.playerUid == request.auth.uid || isStaff());

      // La fiche visée, telle qu'elle est (noms recopiés, joueur, statut).
      function sheet(cid) { return get(charPath(cid)).data; }

      allow create: if signedIn()
        && request.resource.data.playerUid == request.auth.uid
        && sheet(request.resource.data.characterId).get('playerUid', null) == request.auth.uid
        && sheet(request.resource.data.characterId).status == 'active'
        && request.resource.data.characterName == sheet(request.resource.data.characterId).name
        && request.resource.data.playerName == sheet(request.resource.data.characterId).get('playerName', null)
        && request.resource.data.status in ['draft', 'pending']
        && request.resource.data.version == 1
        && request.resource.data.get('thread', []).size() == 0
        && request.resource.data.get('decidedAt', null) == null
        && request.resource.data.get('decidedByUid', null) == null;

      allow update: if signedIn()
        && request.resource.data.version == resource.data.version + 1
        && (playerRequestEdit() || staffRequestDecision());

      // Le fil ne fait que grandir de [n] messages ; les anciens restent identiques.
      function threadGrowsBy(n) {
        let old = resource.data.get('thread', []);
        let now = request.resource.data.get('thread', []);
        // Découper une liste vide ([0:0]) est une erreur d'évaluation : cas à part.
        return now.size() == old.size() + n && (old.size() == 0 || now[0:old.size()] == old);
      }
      function lastMessageMine() {
        let now = request.resource.data.thread;
        return now[now.size() - 1].byUid == request.auth.uid
          && now[now.size() - 1].byName == get(userPath(request.auth.uid)).data.displayName
          && now[now.size() - 1].text.size() > 0;
      }

      function playerRequestEdit() {
        return resource.data.playerUid == request.auth.uid
          && sheet(resource.data.characterId).get('playerUid', null) == request.auth.uid
          && sheet(resource.data.characterId).status == 'active'
          && resource.data.status in ['draft', 'pending', 'changes']
          && request.resource.data.status in ['draft', 'pending', 'cancelled']
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['characterId', 'characterName', 'playerUid', 'playerName', 'decidedAt', 'decidedByUid', 'createdAt'])
          && (threadGrowsBy(0) || (threadGrowsBy(1) && lastMessageMine()));
      }

      function staffRequestDecision() {
        let to = request.resource.data.status;
        let cid = resource.data.characterId;
        return managesAccounts() && resource.data.playerUid != request.auth.uid
          && resource.data.status == 'pending' && to in ['changes', 'rejected', 'accepted']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'thread', 'decidedAt', 'decidedByUid', 'updatedAt', 'version'])
          && ((to == 'accepted'
                && sheet(cid).status == 'active'
                && (threadGrowsBy(0) || (threadGrowsBy(1) && lastMessageMine()))
                && getAfter(charPath(cid)).data.version == get(charPath(cid)).data.version + 1)
            || (to != 'accepted' && threadGrowsBy(1) && lastMessageMine()));
      }
    }


    // Référentiel des règles (sous-projet 5) : lu par tous, écrit par les conteurs.
    match /rules/{cat} {
      allow read: if signedIn();
      allow write: if managesAccounts();

      match /ruleEntries/{id} {
        allow read: if signedIn();
        allow delete: if managesAccounts();
        allow create, update: if managesAccounts()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.state in ['available', 'approval', 'draft', 'forbidden']
          && request.resource.data.data is map
          && request.resource.data.updatedByUid == request.auth.uid;

        // Note réservée au conte : un document à part, Firestore ne cache pas un champ.
        match /private/{doc} {
          allow read: if isStaff();
          allow write: if managesAccounts();
        }
      }
    }

    // Toutes les catégories en une requête (écran du référentiel, moteurs du plan B).
    match /{path=**}/ruleEntries/{id} {
      allow read: if signedIn();
    }

    // Lieux d'intérêt (sous-projet 6a) : privés ; résumé public à part.
    function placeHistPath(id, h) { return /databases/$(database)/documents/places/$(id)/history/$(h); }
    function placeValid() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.type in ['standard', 'prestige', 'iconic']
        && d.rank is int && d.rank >= 1 && d.rank <= 5
        && d.qualities is list && d.holders is list && d.holderIds is list && d.holderPlayers is list
        && d.public is bool;
    }
    function placeHistoryOk(id) {
      let h = getAfter(placeHistPath(id, request.resource.data.lastHistoryId)).data;
      return h.byUid == request.auth.uid && h.at == request.time;
    }

    match /places/{id} {
      allow read: if isStaff() || (signedIn() && request.auth.uid in resource.data.holderPlayers);
      allow create: if managesAccounts() && placeValid() && request.resource.data.version == 1 && placeHistoryOk(id);
      allow update: if managesAccounts() && placeValid()
        && request.resource.data.version == resource.data.version + 1 && placeHistoryOk(id);
      allow delete: if managesAccounts();

      match /private/{doc} {
        allow read: if isStaff();
        allow write: if managesAccounts();
      }

      match /history/{h} {
        allow read: if isStaff();
        allow create: if managesAccounts()
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/places/$(id)).data.lastHistoryId == h;
        allow delete: if managesAccounts();
      }
    }

    match /publicPlaces/{id} {
      allow read: if signedIn();
      allow create, update: if managesAccounts() && request.resource.data.keys().hasOnly(['name', 'type', 'known']);
      allow delete: if managesAccounts();
    }

    // Serviteurs et mortels (sous-projet 6b) : lus par l'équipe et le joueur du domitor.
    function servantValid() {
      let d = request.resource.data;
      return d.kind in ['human', 'animal', 'mortal']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.vitae is int && d.vitae >= 0 && d.vitae <= 5
        && d.bond is int && d.bond >= 0 && d.bond <= 3
        && d.specialties is list && d.qualities is list && d.holderPlayers is list;
    }
    function servantHistoryOk(id) {
      let h = getAfter(/databases/$(database)/documents/servants/$(id)/history/$(request.resource.data.lastHistoryId)).data;
      return h.byUid == request.auth.uid && h.at == request.time;
    }

    match /servants/{id} {
      allow read: if isStaff() || (signedIn() && request.auth.uid in resource.data.holderPlayers);
      allow create: if managesAccounts() && servantValid() && request.resource.data.version == 1 && servantHistoryOk(id);
      allow update: if managesAccounts() && servantValid()
        && request.resource.data.version == resource.data.version + 1 && servantHistoryOk(id);
      allow delete: if managesAccounts();

      match /private/{doc} {
        allow read: if isStaff();
        allow write: if managesAccounts();
      }

      match /history/{h} {
        allow read: if isStaff();
        allow create: if managesAccounts()
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/servants/$(id)).data.lastHistoryId == h;
        allow delete: if managesAccounts();
      }
    }

    // PNJ confiés (sous-projet 6e) : en-tête lisible par son joueur ; copie de la fiche pendant la période seulement.
    function loanOpen(l) {
      return l.get('revokedAt', null) == null && l.from <= request.time && request.time <= l.until;
    }

    match /npcLoans/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.playerUid == request.auth.uid);
      allow create: if managesAccounts() && request.resource.data.version == 1
        && request.resource.data.until > request.resource.data.from;
      allow update: if (managesAccounts() && request.resource.data.version == resource.data.version + 1
          && request.resource.data.until > request.resource.data.from)
        || (signedIn() && resource.data.playerUid == request.auth.uid && resource.data.allowNotes == true && loanOpen(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerNotes', 'notesAt'])
          && request.resource.data.notesAt == request.time
          && request.resource.data.playerNotes is string && request.resource.data.playerNotes.size() <= 5000);
      allow delete: if managesAccounts();

      match /sheet/{doc} {
        allow read: if isStaff() || (signedIn()
          && get(/databases/$(database)/documents/npcLoans/$(id)).data.playerUid == request.auth.uid
          && loanOpen(get(/databases/$(database)/documents/npcLoans/$(id)).data));
        allow write: if managesAccounts();
      }
    }

    match /invitations/{email} {
      allow read: if isPrincipal() || (signedIn() && tokenEmail() == email);
      allow create, update: if isPrincipal()
        && request.resource.data.role in ['joueur', 'narrateur', 'conteur'];
      allow delete: if isPrincipal();
    }
  }
}
